# Copie para .env  (cp .env.example .env). NUNCA commite o .env.

# Tags unificadas
DD_ENV=lab
DD_VERSION=0.1.0

# Site do Datadog da sua organização: datadoghq.com | us3.datadoghq.com | us5.datadoghq.com | datadoghq.eu | ap1.datadoghq.com
DD_SITE=datadoghq.com

# Necessário apenas com --profile datadog (Agent enviando APM + logs)
DD_API_KEY=

# Opcional: RUM no dashboard (Digital Experience > Add an Application > Browser)
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=

# Limites de latência do laboratório (ms)
SLO_INICIAR_MS=500
SLO_AUTORIZAR_MS=1000
SLO_CONFIRMAR_MS=500
ACQUIRER_TIMEOUT_MS=2000

# Porta do dashboard no navegador
DASHBOARD_PORT=3000
